<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fitsSystemWindows="true"
    tools:context=".activities.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp"
            android:background="@color/dash_bg"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Hamburger Menu (Left) -->
            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/search_edittext_bg"
                android:padding="8dp"
                android:src="@drawable/ic_menu_hamburger"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/dash_icon_tint" />

            <!-- Logo and Title (Center) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/scholaria_logo" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Scholaria"
                    android:textColor="@color/dash_teal"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Search (Right) -->
            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/search_edittext_bg"
                android:padding="8dp"
                android:src="@drawable/ic_search_custom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/dash_icon_tint" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sub Navigation Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:id="@+id/subNavBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView android:id="@+id/navHome" style="@style/SubNavIcon" android:src="@drawable/ic_nav_dashboard" />
                <ImageView android:id="@+id/navCourses" style="@style/SubNavIcon" android:src="@drawable/ic_nav_courses" />

                <!-- Added Students Icon for Teacher -->
                <ImageView android:id="@+id/navStudents"
                    style="@style/SubNavIcon"
                    android:src="@drawable/ic_nav_students"
                    android:visibility="gone" />

                <ImageView android:id="@+id/navTasks" style="@style/SubNavIcon" android:src="@drawable/ic_nav_tasks" />
                <ImageView android:id="@+id/navMessages" style="@style/SubNavIcon" android:src="@drawable/ic_nav_messages" />
                <ImageView android:id="@+id/navNotifications" style="@style/SubNavIcon" android:src="@drawable/ic_nav_notifications" />
                <ImageView android:id="@+id/navProfile" style="@style/SubNavIcon" android:src="@drawable/ic_nav_profile" />
            </LinearLayout>

            <!-- Sliding Indicator -->
            <View
                android:id="@+id/navIndicator"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@color/dash_teal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/navDivider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider_color"
            app:layout_constraintTop_toBottomOf="@id/navContainer" />

        <!-- ViewPager for Content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/mainViewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/navDivider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        android:background="@color/dash_bg"
        app:itemTextColor="@color/dash_text_primary"
        app:itemIconTint="@color/dash_icon_tint" />

</androidx.drawerlayout.widget.DrawerLayout>
